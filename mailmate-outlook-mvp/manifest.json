{
  "manifest_version": 3,
  "name": "Mailmate 邮件助手",
  "version": "0.5.5",
  "description": "用户点击开始后，分析当前 Outlook 文件夹近两周邮件并展示摘要。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://mailmate-telemetry.mailmate-telemetry-261117.workers.dev/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.cloud.microsoft/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*"
      ],
      "js": ["telemetry-config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/outlook-settings-gear.png", "assets/outlook-mail-handling.png"],
      "matches": [
        "https://outlook.cloud.microsoft/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*"
      ]
    }
  ],
  "action": { "default_title": "Mailmate 邮件助手" }
}
