{
  "manifest_version": 3,
  "name": "Mailmate — Outlook MVP",
  "version": "0.1.0",
  "description": "Read and analyze the currently open Outlook Web email after the user clicks.",
  "permissions": [],
  "host_permissions": ["https://api.groq.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.cloud.microsoft/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Mailmate — open Outlook and use the Mailmate button" }
}
